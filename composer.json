{
    "name": "edrisaturay/filament-starter-minimal",
    "description": "Minimal Filament v5 starter plugin: essential panel plugins only (Shield-first, extensible registry).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Edrisa A Turay",
            "email": "edrisa@edrisa.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "awcodes/filament-quick-create": "^5.0",
        "bezhansalleh/filament-exceptions": "^4.2",
        "bezhansalleh/filament-language-switch": "^4.3.0",
        "bezhansalleh/filament-panel-switch": "^3.1.0",
        "bezhansalleh/filament-shield": "^4.2.0",
        "caresome/filament-auth-designer": "^3.1.0",
        "charrafimed/global-search-modal": "^5.0.0",
        "datlechin/filament-menu-builder": "^1.0",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "guava/filament-knowledge-base": "^3.1.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "illuminate/database": "^11.28|^12.0|^13.0",
        "illuminate/support": "^11.28|^12.0|^13.0",
        "jeffgreco13/filament-breezy": "^3.2.5",
        "mradder/filament-logger": "^1.4",
        "pxlrbt/filament-spotlight": "^2.1",
        "rawand201/filament-connection-badge": "^1.0",
        "rupadana/filament-api-service": "^5.0",
        "shuvroroy/filament-spatie-laravel-backup": "^3.4.0",
        "shuvroroy/filament-spatie-laravel-health": "^3.3.0",
        "slimani/filament-media-manager": "^0.13",
        "stechstudio/filament-impersonate": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.7.0",
        "pestphp/pest-plugin-laravel": "^4.1.0"
    },
    "suggest": {
        "kenepa/resource-lock": "Prevent two users from editing the same record simultaneously (no Filament v5 release yet — registry entry is class_exists-guarded).",
        "filament/spatie-laravel-settings-plugin": "Settings pages backed by spatie/laravel-settings (component package).",
        "filament/spatie-laravel-tags-plugin": "Filament form components for spatie/laravel-tags (component package).",
        "riodwanto/filament-ace-editor": "Ace code-editor form field for Filament (component package).",
        "ralphjsmit/laravel-filament-components": "Collection of handy Filament form/table components (component package).",
        "ysfkaya/filament-phone-input": "International phone-number form field (component package).",
        "owen-it/laravel-auditing": "Eloquent auditing trait — wire into your models, not registered as a Filament plugin."
    },
    "autoload": {
        "psr-4": {
            "EdrisaTuray\\FilamentStarterMinimal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdrisaTuray\\FilamentStarterMinimal\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EdrisaTuray\\FilamentStarterMinimal\\FilamentStarterMinimalServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
